# Database Configuration (Supports SQLite and PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# For PostgreSQL in production (put the real value only in your host's secret settings):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>

# Security & Session Authentication
# In development these may stay empty: random values are generated once and kept
# in the git-ignored file .dev_secrets.json. In production (ENVIRONMENT=production)
# the server refuses to start unless every one of them is set.
SECRET_KEY=""
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
GITHUB_WEBHOOK_SECRET=""
# Must be a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=""
ZYLORUN_CRON_SECRET=""

# Administrator account. There is no built-in password: the admin account is
# disabled until ADMIN_PASSWORD (12+ characters) is set. It is applied at startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Password reset e-mails (optional). Without SMTP, reset links cannot be sent;
# in development the link is written to the server log instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
PASSWORD_RESET_TOKEN_MINUTES=30

# GitHub Integration & OAuth (Optional, for GitHub Repository Sync)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Provider Configuration (Optional, for AI Fix Assistance). There is no built-in key.
AI_PROVIDER=gemini
GEMINI_API_KEY=""
# Or OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=""

# Frontend Application Origin (comma separated; must be HTTPS in production, no wildcard)
FRONTEND_URL=http://localhost:5173
